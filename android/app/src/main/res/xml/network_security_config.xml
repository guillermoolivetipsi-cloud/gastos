<?xml version="1.0" encoding="utf-8"?>
<!-- «Mandar a Finanzas»: Finanzas escucha en la Mac, dentro de la red de casa, por http
     (192.168.x.x:3005). Android no deja limitar esto a "la red local" por rango de IP,
     así que se permite http en general; la app solo usa http para hablar con Finanzas
     (lo demás, cotizaciones y GitHub, es https). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
